{
  "name": "freezer-audit",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:serve": "cross-env NODE_OPTIONS=\"--import ./mocks/index.js\" react-router-serve ./build/server/index.js",
    "format": "prettier --write .",
    "lint": "oxlint",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "start:mocks": "cross-env NODE_OPTIONS=\"--import ./mocks/index.js\" react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:dev": "cross-env start-server-and-test dev http://localhost:3000 \"npx cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env PORT=8811 start-server-and-test start:mocks http://localhost:8811 \"npx cypress run\"",
    "typecheck": "react-router typegen && tsc",
    "validate": "npm-run-all --parallel \"test -- --run\" lint typecheck test:e2e:run"
  },
  "prettier": {},
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/.react-router/"
  ],
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-router/fs-routes": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.5.0",
    "isbot": "^5.2.1",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router": "^8.3.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cookie": "^2.0.1",
    "cross-env": "^10.1.0",
    "cypress": "^15.20.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "msw": "^2.15.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "26.7"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "better-sqlite3@12.11.1": true,
    "cypress@15.20.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "msw@2.15.0": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
