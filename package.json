{
  "name": "freezer-audit",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:serve": "cross-env NODE_OPTIONS=\"--import ./mocks/index.js\" react-router-serve ./build/server/index.js",
    "format": "prettier --write .",
    "lint": "oxlint",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "start:mocks": "cross-env NODE_OPTIONS=\"--import ./mocks/index.js\" react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:dev": "cross-env start-server-and-test dev http://localhost:3000 \"npx cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env PORT=8811 start-server-and-test start:mocks http://localhost:8811 \"npx cypress run\"",
    "typecheck": "react-router typegen && tsc",
    "validate": "npm-run-all --parallel \"test -- --run\" lint typecheck test:e2e:run"
  },
  "prettier": {},
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build",
    "/.react-router/"
  ],
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/fs-routes": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.6",
    "fuse.js": "^7.5.0",
    "isbot": "^5.2.2",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-router": "^8.4.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cookie": "^2.0.1",
    "cross-env": "^10.1.0",
    "cypress": "^16.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "msw": "^3.0.2",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "26.7"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "cypress@16.1.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.0": true
  }
}
