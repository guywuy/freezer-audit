{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "jest"
  ],
  "categories": {
    "correctness": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/jsx-no-leaked-render": "warn"
  },
  "ignorePatterns": [
    "public/build/**",
    "build/**",
    ".react-router/**",
    "node_modules/**"
  ],
  "settings": {
    "react": {
      "version": "19.2"
    },
    "jsx-a11y": {
      "polymorphicPropName": "as"
    }
  }
}
